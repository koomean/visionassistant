    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the camera to take photos, read text, and measure distance with LiDAR on supported devices. Photos and depth data are processed on your device."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กล้องเพื่อถ่ายภาพ อ่านข้อความ และวัดระยะด้วย LiDAR บนเครื่องที่รองรับ ภาพและข้อมูลระยะประมวลผลบนเครื่องของคุณ"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record questions in Thai or English about your photos. Speech is transcribed on your device, and recordings are deleted after each question."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับคำถามเสียงภาษาไทยและอังกฤษเพื่อถามเกี่ยวกับภาพ เสียงถอดเป็นข้อความบนเครื่องและลบทิ้งเมื่อจบคำถาม"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe questions with on-device iOS Dictation models, without sending audio to servers."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถอดคำถามด้วยโมเดล Dictation ของ iOS บนเครื่อง โดยไม่ส่งเสียงไปเซิร์ฟเวอร์"
          }
        }
      }
    }
  },
  "version" : "1.0"
